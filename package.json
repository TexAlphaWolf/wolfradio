{
  "name": "wolfradio",
  "version": "2.0.0",
  "description": "Self-hosted Discord music bot: pick-the-right-result search, your own library, Creative Commons music and world radio.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json && vite build --config activity/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "deploy": "node --env-file-if-exists=.env dist/deploy-commands.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p activity/tsconfig.json",
    "build:bot": "tsc -p tsconfig.json",
    "build:activity": "vite build --config activity/vite.config.ts",
    "dev:activity": "vite --config activity/vite.config.ts"
  },
  "author": "TexAlphaWolf",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.28.1",
    "lavalink-client": "^2.11.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TexAlphaWolf/wolfradio.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "music-bot",
    "lavalink",
    "navidrome",
    "radio",
    "jamendo"
  ]
}
