# ── Discord ─────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
# Optional: register slash commands only in this server (instant updates while developing)
DEV_GUILD_ID=

# ── Lavalink (audio server) ─────────────────────────────
# In docker-compose the host is the service name "lavalink"
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me
LAVALINK_SECURE=false

# ── Sources ─────────────────────────────────────────────
# Deezer catalog search + official 30-second previews (no key needed)
ENABLE_PREVIEWS=true

# Creative Commons full tracks — free client id at https://devportal.jamendo.com
ENABLE_JAMENDO=false
JAMENDO_CLIENT_ID=

# Your own music library through Navidrome (Subsonic API)
ENABLE_LIBRARY=false
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Your music library folder (used by docker-compose for Navidrome) and the compose profile to start it
#MUSIC_DIR=B:/Music
#COMPOSE_PROFILES=library

# Web radios from all over the world (radio-browser.info)
ENABLE_RADIO=false

# ── Lyrics & voice channel status ───────────────────────
# Song title shown under the voice channel name.
# Needs the "Set Voice Channel Status" permission for the bot(s).
VOICE_CHANNEL_STATUS=true
# Time-synced lyrics from LRCLIB for full tracks (library, Jamendo)
ENABLE_LYRICS=false
LYRICS_IN_NOW_PLAYING=true
# Also put the current lyric line in the voice channel status (instead of just the title)
LYRICS_IN_VOICE_STATUS=false
# Positive = show lines earlier (compensates Discord's audio delay)
LYRICS_OFFSET_MS=400

# ── Spotify listening party ─────────────────────────────
# Everyone hears the same song on their OWN Spotify app (Premium); nothing is streamed by the bot.
# Create an app at https://developer.spotify.com/dashboard (Web API), add this redirect URI
# and add every listener in "User Management" (Development mode: max 5 users).
ENABLE_SPOTIFY_PARTY=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_CALLBACK_PORT=8888
# Encrypts the stored Spotify tokens — any random string of 32+ characters. Don't change it later.
TOKEN_ENCRYPTION_KEY=

# "Song request" channel: members type a title and get the picker.
# Needs the Message Content intent enabled in the Discord Developer Portal.
ENABLE_REQUEST_CHANNEL=false

# ── Behaviour ───────────────────────────────────────────
# Bot messages disappear after this many seconds (0 = keep them). The live cards update themselves.
AUTO_DELETE_SECONDS=180
DEFAULT_VOLUME=60
MAX_QUEUE_PER_USER=15
COMMAND_COOLDOWN_SECONDS=3
IDLE_LEAVE_SECONDS=120
VOTE_SKIP_RATIO=0.5
DATA_DIR=./data